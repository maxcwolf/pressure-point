{
  "name": "pressure-point",
  "productName": "Pressure Point Institute",
  "version": "0.26.0",
  "description": "A healing-center management sim.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "lab": "vite --open /lab.html",
    "build": "tsc -b && yarn build:web && yarn build:desktop",
    "build:web": "vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "brand": "node scripts/make-brand.mjs",
    "announcer": "node scripts/make-announcer.mjs",
    "postinstall": "husky",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:desktop": "yarn build && playwright test --config playwright.desktop.config.ts",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "bench": "vitest run --config vitest.bench.config.ts",
    "preview": "vite preview",
    "app": "yarn build && electron .",
    "dist:mac": "yarn build && electron-builder --mac --arm64 --x64 -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:win": "yarn build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.maxwolf.pressurepoint",
    "productName": "Pressure Point Institute",
    "artifactName": "Pressure-Point-Institute-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.simulation-games",
      "icon": "build/icon-mac.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@sentry/browser": "^11.7.0",
    "preact": "^11.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
